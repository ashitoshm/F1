FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Add Flask-specific dependencies
RUN pip install --no-cache-dir flask psycopg2-binary requests

COPY backend /app/backend
COPY templates /app/templates

# Update the DB configuration to use Docker service names
COPY backend/app.py /app/
RUN sed -i 's/"host": "localhost"/"host": "postgres"/g' /app/app.py

EXPOSE 5000

CMD ["python", "app.py"]